# Copy to .env and fill in. Never commit .env.

# --- AI (Gemini) ---
# Which way the marking service reaches Gemini.
#   google  = use GEMINI_API_KEY from Google AI Studio. Default. Works anywhere, for anyone who clones the repo.
#   demo    = never call an AI. Return saved example results for the sample questions. Used for the hosted prototype.
#   replit  = use Replit AI Integrations, billed to the owner's Replit credits. Only works on the owner's Replit app.
AI_PROVIDER=google
# Needed when AI_PROVIDER=replit: Replit sets AI_INTEGRATIONS_GEMINI_BASE_URL and
# AI_INTEGRATIONS_GEMINI_API_KEY itself once the Gemini integration is added to the
# Replit app that runs the marking service. Do not copy them anywhere else.
# Needed when AI_PROVIDER=google. Create a key in Google AI Studio. Not needed when AI_PROVIDER=replit:
# Replit supplies its own access then, so check Replit's docs for how.
GEMINI_API_KEY=
# The model is one setting so it can be swapped. Example: a Flash-class model. Check the current names.
GEMINI_MODEL=

# --- Supabase ---
SUPABASE_URL=
# Safe for the browser. Protected by the database access rules.
SUPABASE_ANON_KEY=
# SERVER ONLY. Never put this in browser code or commit it.
SUPABASE_SERVICE_ROLE_KEY=

# --- App ---
APP_URL=http://localhost:3000
# Optional. If set, only emails from this domain may sign in, for example school.edu.my
ALLOWED_EMAIL_DOMAIN=

# --- Marking behaviour ---
# Number of independent solve runs used when no verified answer exists.
MARK_SOLVE_RUNS=2

# --- Marking service ---
# Port the marking service listens on.
PORT=3001
# Dev sign-in: the service accepts "Authorization: Bearer <this value>". Any long random string.
# Replaced by a Supabase token check once a Supabase project exists.
MARK_AUTH=dev
MARK_DEV_TOKEN=
# Requests per user per minute.
MARK_RATE_PER_MIN=10
