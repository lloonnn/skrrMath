# Copy to .env and fill in. Never commit .env.

# --- AI (Gemini) ---
# Not needed if Replit AI Integrations is active on your account. Replit sets its own
# variables then, so check Replit's docs for their names. Otherwise create a key in
# Google AI Studio.
GEMINI_API_KEY=
# The model is one setting so it can be swapped. Example: a Flash-class model. Check the current names.
GEMINI_MODEL=

# --- Supabase ---
SUPABASE_URL=
# Safe for the browser. Protected by the database access rules.
SUPABASE_ANON_KEY=
# SERVER ONLY. Never put this in browser code or commit it.
SUPABASE_SERVICE_ROLE_KEY=

# --- App ---
APP_URL=http://localhost:3000
# Optional. If set, only emails from this domain may sign in, for example school.edu.my
ALLOWED_EMAIL_DOMAIN=

# --- Marking behaviour ---
# Number of independent solve runs used when no verified answer exists.
MARK_SOLVE_RUNS=2
