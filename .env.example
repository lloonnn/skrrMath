# Copy to .env and fill in. Never commit .env.

# --- AI (Gemini) ---
# Which way the marking service reaches Gemini.
#   google  = use GEMINI_API_KEY from Google AI Studio. Default. Works anywhere, for anyone who clones the repo.
#   demo    = never call an AI. Return saved example results for the sample questions. Used for the hosted prototype.
#   replit  = use Replit AI Integrations, billed to the owner's Replit credits. Only works on the owner's Replit app.
AI_PROVIDER=google
# Needed when AI_PROVIDER=replit: Replit sets AI_INTEGRATIONS_GEMINI_BASE_URL and
# AI_INTEGRATIONS_GEMINI_API_KEY itself once the Gemini integration is added to the
# Replit app that runs the marking service. Do not copy them anywhere else.
# Needed when AI_PROVIDER=google. Create a key in Google AI Studio. Not needed when AI_PROVIDER=replit:
# Replit supplies its own access then, so check Replit's docs for how.
GEMINI_API_KEY=
# The model is one setting so it can be swapped. Example: a Flash-class model. Check the current names.
GEMINI_MODEL=

# --- Supabase ---
SUPABASE_URL=
# Safe for the browser. Protected by the database access rules.
SUPABASE_ANON_KEY=
# SERVER ONLY. Never put this in browser code or commit it.
SUPABASE_SERVICE_ROLE_KEY=

# --- App ---
# Where the web app runs while you develop (npm run dev). The marking service allows this address.
APP_URL=http://localhost:5173

# --- Marking behaviour ---
# Number of independent solve runs used when no verified answer exists.
MARK_SOLVE_RUNS=2

# --- Marking service ---
# Port the marking service listens on.
PORT=3001
# How the marking service checks who is asking. Two choices:
#   supabase = the user's own Supabase sign-in. Use this for real marking. The app sends the
#              signed-in user's token, and the service asks Supabase if it is valid. Needs
#              SUPABASE_URL and SUPABASE_ANON_KEY (set above). MARK_DEV_TOKEN is not used.
#   dev      = one shared password, MARK_DEV_TOKEN below, for trying the service with curl.
#              Never use it in the browser app.
MARK_AUTH=supabase
# Only for MARK_AUTH=dev. Any long random string. Leave empty when MARK_AUTH=supabase.
MARK_DEV_TOKEN=
# Requests per user per minute.
MARK_RATE_PER_MIN=10

# --- Web app: marking ---
# What the Mark button does in the web app:
#   demo    = shows a saved example page and calls no AI. Anyone can press it, signed in or not.
#             The hosted prototype uses this.
#   service = sends the question image and your writing to the marking service, for real.
#             Needs the user to be signed in, and MARK_AUTH=supabase above.
# Restart the web app (npm run dev) after changing it.
MARK_MODE=service
# Optional. Where the web app sends marking requests. Leave empty to use /api/mark, which the dev
# server passes on to the marking service on PORT.
MARK_URL=

# --- Lecturers ---
# The code that makes a signed-in person a lecturer. Any simple code, at least 6 characters.
# After you set or change it, run: node --env-file=.env scripts/set-lecturer-code.mjs
LECTURER_CODE=
